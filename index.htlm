<!DOCTYPE html>
        }

        const nilai = Number(checked.value);
        jawaban[questions[i].id] = nilai;

        if (questions[i].scale === 'depresi') depresi += nilai;
        if (questions[i].scale === 'kecemasan') kecemasan += nilai;
        if (questions[i].scale === 'stres') stres += nilai;
      }

      depresi *= 2;
      kecemasan *= 2;
      stres *= 2;

      const hasil = {
        depresi: { skor: depresi, kategori: kategoriDepresi(depresi) },
        kecemasan: { skor: kecemasan, kategori: kategoriKecemasan(kecemasan) },
        stres: { skor: stres, kategori: kategoriStres(stres) }
      };

      document.getElementById('resultCard').style.display = 'block';
      document.getElementById('resultGrid').innerHTML = `
        <div class="result-box"><div>Depresi</div><div class="score">${hasil.depresi.skor}</div><div>${hasil.depresi.kategori}</div></div>
        <div class="result-box"><div>Kecemasan</div><div class="score">${hasil.kecemasan.skor}</div><div>${hasil.kecemasan.kategori}</div></div>
        <div class="result-box"><div>Stres</div><div class="score">${hasil.stres.skor}</div><div>${hasil.stres.kategori}</div></div>
      `;

      const payload = { nama, nip, email, bagian, jawaban, hasil };

      status.textContent = 'Mengirim data...';
      status.style.color = '#2563eb';

      try {
        const response = await fetch(https://script.google.com/macros/s/AKfycbxKVYVMEscFB8CO9lPrA7RG5fszsRGnDswGFE_mGAEd9wT1t9Bx6rt5fQHtIGaJARWsjw/exec, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (data.success) {
          status.textContent = 'Hasil berhasil dikirim ke spreadsheet dan email.';
          status.style.color = 'green';
        } else {
          status.textContent = 'Gagal menyimpan: ' + data.message;
          status.style.color = 'red';
        }
      } catch (error) {
        status.textContent = 'Error koneksi: ' + error.message;
        status.style.color = 'red';
      }
    }

    function resetForm() {
      document.getElementById('nama').value = '';
      document.getElementById('nip').value = '';
      document.getElementById('email').value = '';
      document.getElementById('bagian').value = '';
      document.querySelectorAll('input[type="radio"]').forEach(el => el.checked = false);
      document.getElementById('status').textContent = '';
      document.getElementById('resultCard').style.display = 'none';
    }

    renderQuestions();
  </script>
</body>
</html>
