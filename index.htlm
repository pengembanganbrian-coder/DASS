<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DASS-21 Test</title>
</head>
<body>

<h1>DASS-21 (Depression Anxiety Stress Scale)</h1>

<p>Isi sesuai kondisi Anda selama seminggu terakhir.</p>

<form id="formDASS">

<div id="questions"></div>

<button type="button" onclick="hitung()">Lihat Hasil</button>

</form>

<h2 id="hasil"></h2>

<script>
const pertanyaan = [
  "Sulit untuk bersantai",
  "Mulut sering kering",
  "Tidak bisa merasakan perasaan positif",
  "Kesulitan bernapas",
  "Tidak kuat melakukan kegiatan",
  "Bereaksi berlebihan",
  "Gemetar",
  "Banyak energi habis karena cemas",
  "Takut panik",
  "Tidak ada harapan",
  "Gelisah",
  "Sulit bersantai",
  "Sedih dan tertekan",
  "Tidak sabar",
  "Hampir panik",
  "Tidak antusias",
  "Tidak berharga",
  "Mudah tersinggung",
  "Detak jantung terasa",
  "Takut tanpa alasan",
  "Hidup tidak bermanfaat"
];

const skala = [
  'stress','anxiety','depression','anxiety','depression','stress','anxiety','stress','anxiety','depression','stress','stress','depression','stress','anxiety','depression','depression','stress','anxiety','anxiety','depression'
];

const container = document.getElementById("questions");

pertanyaan.forEach((p, i) => {
  const div = document.createElement("div");
  div.innerHTML = `
    <p>${i+1}. ${p}</p>
    <label><input type="radio" name="q${i}" value="0"> Tidak pernah</label>
    <label><input type="radio" name="q${i}" value="1"> Kadang</label>
    <label><input type="radio" name="q${i}" value="2"> Sering</label>
    <label><input type="radio" name="q${i}" value="3"> Sangat sering</label>
  `;
  container.appendChild(div);
});

function hitung(){
  let d=0,a=0,s=0;

  for(let i=0;i<21;i++){
    const val = document.querySelector(`input[name=q${i}]:checked`);
    if(!val){
      alert("Semua soal harus diisi");
      return;
    }

    const v = parseInt(val.value);

    if(skala[i]==='depression') d+=v;
    if(skala[i]==='anxiety') a+=v;
    if(skala[i]==='stress') s+=v;
  }

  d*=2; a*=2; s*=2;

  document.getElementById("hasil").innerText =
    `Depresi: ${d} | Anxiety: ${a} | Stress: ${s}`;
}
</script>

</body>
</html>
